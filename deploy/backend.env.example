# Copy to deploy/production.env and fill locally or in your host's secret settings.
# Compose reads this file in raw format: do not wrap values in quotes.
# Do not copy Java .properties escaping from .env.local; use the actual values.
# Never commit production.env or pass this file as a React build argument.

SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:mysql://YOUR_AIVEN_HOST:YOUR_PORT/defaultdb?sslMode=REQUIRED
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
APP_FRONTEND_URL=https://stay.example.com
APP_CORS_ALLOWED_ORIGINS=https://stay.example.com
STAY_REMEMBER_ME_KEY=

# Used by bare-JAR and standalone-container deployments. Compose mounts this path.
STAY_MEDIA_DIRECTORY=/var/lib/stay/hotel-images

# Sandbox only. Hosted Stripe webhook secret differs from a stripe listen secret.
STAY_PAYMENTS_ENABLED=true
STAY_PAYMENT_SCHEDULING_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Gmail SMTP configuration when STAY_MAIL_PROVIDER=smtp.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587

# Use the existing administrator in this database. Bootstrap is opt-in for a new DB.
STAY_ADMIN_BOOTSTRAP_ENABLED=false
STAY_DB_POOL_SIZE=5

# Same-origin /api proxy uses lax. Cross-site hosting may need none and is less reliable.
SESSION_COOKIE_SAME_SITE=lax

# Photo storage: use cloudinary for hosts without persistent disks (for example Render Free).
# Keep local until Cloudinary credentials are filled; migrate existing photos before deployment.
STAY_MEDIA_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
STAY_CLOUDINARY_PREFIX=stay

# HTTPS mail delivery for hosts that block SMTP (Render Free).
# Use a Brevo API key and an already verified sender, not an SMTP key.
STAY_MAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=STAY
