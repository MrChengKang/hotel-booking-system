# Public build-time setting only. Keep /api for the supplied same-origin proxy.
# React environment variables are visible in the browser: never add secrets here.
REACT_APP_API_URL=/api

# Vercel configuration only (public backend origin, no /api suffix).
# Add this to the Vercel project environment before deployment.
STAY_BACKEND_ORIGIN=https://YOUR-STAY-SERVICE.onrender.com
